# Path to Mahyco root
cd /path/to/MaHyCo/build_${OS}/${build_type}/src

# If cluster mode
source ../../../env_gcc12.3_cuda12.4_mpi4.1.7.sh

cp ../../../etude_CAS_BiSodCaseX/strong_extensibility/Donnees_*  .  # 5 M de mailles

#############
# MPI PURE  #
#############
ccc_mprun -l -N 1 -n 16  -c 2  -p gh200-bxi                                          ./Mahyco  -A, Max_iteration 1000                                        Donnees_CPU_nsd04x2x2.arc > ../../../etude_CAS_BiSodCaseX/strong_extensibility/listing_gh200_n16c2
ccc_mprun -l -N 1 -n 32  -c 2  -p gh200-bxi                                          ./Mahyco  -A, Max_iteration 1000                                        Donnees_CPU_nsd08x2x2.arc > ../../../etude_CAS_BiSodCaseX/strong_extensibility/listing_gh200_n32c2
