ccc_mprun -l -N 1 -n 32  -c 2 -p gh200-bxi -E--cpu_bind=verbose,mask_cpu=0x1010101   ./Mahyco  -A, MaxIteration  1000 -A,T=2 -A,ThreadBindingStrategy=Simple Donnees_CPU_nsd08x2x2.arc> ../../../etude_CAS_BiSodCaseX/strong_extensibility/listing_gh200_n32k2
